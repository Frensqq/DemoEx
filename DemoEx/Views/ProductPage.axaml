<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="DemoEx.Views.ProductPage"
        xmlns:vm="using:DemoEx.ViewModels"
        x:DataType="vm:MainWindowViewModel"
        >
           <!--xmlns:conv="using:Demoex"-->
       <ScrollViewer VerticalScrollBarVisibility="Auto">
       <ItemsControl ItemsSource="{Binding Products}">
       <ItemsControl.ItemTemplate>
		   <DataTemplate>
			   <DockPanel LastChildFill="True">
                   <Image 
                       Source="{ Binding Image,Converter={StaticResource ImageConverter}}" 
                       Width="120" 
                       Height="120" 
                       Stretch="Uniform" 
                       DockPanel.Dock="Left"
                       />
				   <TextBlock Text="{Binding Price}" FontSize="24" DockPanel.Dock="Right" />
                   <WrapPanel>
                       <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Manufacture.Name}"/>
                            <TextBlock Text=" | "/>
                            <TextBlock Text="{Binding Name}"/>
                       </WrapPanel>
                   </WrapPanel>
                   <StackPanel Orientation="Vertical">
					   <TextBlock Text="{Binding Structure}"/>
				       <TextBlock Text="{Binding Category.Name ,  StringFormat = категория: {0} }" />
                   </StackPanel>
                   
               </DockPanel>
           </DataTemplate>
       </ItemsControl.ItemTemplate>
       
       </ItemsControl>
       </ScrollViewer>
    

</UserControl>
