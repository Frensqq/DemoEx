<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:DemoEx.ViewModels"
             x:DataType="vm:MainWindowViewModel"
             x:Class="DemoEx.Views.LoginPage">

    <Grid RowDefinitions="Auto,*" Background="#FFFFFF">

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#D2F6E7" Padding="10">
            <TextBlock Text="Авторизация" FontSize="20" FontWeight="700"/>
        </Border>

        <!-- Форма -->
        <StackPanel Grid.Row="1" Width="300" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">

            <TextBlock Text="Логин" FontWeight="600"/>
            <TextBox Text="{Binding Currentlogin}" Watermark="Введите логин"/>

            <TextBlock Text="{Binding LoginError}" Foreground="#ff8080" TextWrapping="Wrap"/>

            <Button Content="Войти"
                    Command="{Binding LoginInCommand}"
                    Background="#70B2AF"
                    Foreground="White"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"/>

            <Button Content="Продолжить как гость"
                    Command="{Binding ToProductPageCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"/>

        </StackPanel>

    </Grid>
</UserControl>