<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:DemoEx.ViewModels"
             x:DataType="vm:MainWindowViewModel"
             x:Class="DemoEx.Views.LoginPage">

    <Grid RowDefinitions="Auto,*" Background="#F7F7F7">

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#3A3438" Padding="20,14">
            <TextBlock Text="Авторизация"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="700"/>
        </Border>

        <!-- Форма -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                Width="320"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="12">

                <TextBlock Text="Логин"
                           FontWeight="600"
                           Foreground="#3A3438"/>

                <TextBox Text="{Binding Login}"
                         Watermark="Введите логин"/>

                <TextBlock Text="{Binding LoginError}"
                           Foreground="#E85A3A"
                           TextWrapping="Wrap"
                           FontSize="13"/>

                <Button Content="Войти"
                        Command="{Binding LoginInCommand}"
                        Background="#E85A3A"
                        Foreground="White"
                        Padding="24,10"
                        CornerRadius="6"
                        FontWeight="600"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,8,0,0"/>

                <Button Content="Продолжить как гость"
                        Command="{Binding ToProductPageCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="24,10"
                        CornerRadius="6"/>

            </StackPanel>
        </Border>

    </Grid>
</UserControl>