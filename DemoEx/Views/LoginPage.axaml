<UserControl xmlns="https://github.com/avaloniaui" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
              xmlns:vm="using:DemoEx.ViewModels"
			 xmlns:conv="clr-namespace:DemoEx.Resources"
			 x:DataType="vm:MainWindowViewModel"
             x:Class="DemoEx.Views.LoginPage">
    <StackPanel VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Width="250"
                Spacing="10">

        <TextBlock Text="Авторизация"
                   FontSize="24"
                   HorizontalAlignment="Center"/>

        <TextBox Text="{Binding Login}" Watermark="Логин"/>

        <TextBlock Text="{Binding LoginError}"
                   Foreground="Red"
                   TextWrapping="Wrap"/>

        <Button Content="Войти"
                HorizontalAlignment="Stretch"
                Command="{Binding LoginInCommand}"/>

        <Button Content="Продолжить как гость"
                HorizontalAlignment="Stretch"
                Command="{Binding BackCommand}"/>

    </StackPanel>

</UserControl>
