<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		xmlns:vm="using:DemoEx.ViewModels"
        x:DataType="vm:MainWindowViewModel"
        x:Class="DemoEx.Views.OrderWindow"
        Title="OrderWindow">

    
					<Grid Grid.ColumnDefinitions="Auto,*,Auto" Margin="10" 
						  Background="{Binding CurrentProduct.Count, Converter={StaticResource ColorConverter}}" >

						<Image Grid.Column="0"
							   Source="{Binding CurrentProduct.Image, Converter={StaticResource ImageConverter}}"
							   Width="120"
							   Height="120"
							   Stretch="Uniform"
							   Margin="8"
							   VerticalAlignment="Center"/>

						<StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
							<TextBlock Classes.hasDiscount = "{Binding CurrentProduct.Discount}"  Text="{Binding CurrentProduct.Price}"
								   FontSize="24"
								   VerticalAlignment="Center"/>	
							<TextBlock IsVisible="{Binding CurrentProduct.Discount}" Text="{Binding CurrentProduct.DiscountPrice}"
								   FontSize="16"
								   FontWeight="400"
								   VerticalAlignment="Center"/>
							
								
							
						</StackPanel>
								  

						<Grid Grid.Column="1"
							  HorizontalAlignment="Stretch"
							  VerticalAlignment="Stretch">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>

							<WrapPanel Grid.Row="0"
									   Orientation="Horizontal"
									   HorizontalAlignment="Center"
									   VerticalAlignment="Top">
								<TextBlock Text="{Binding CurrentProduct.Manufacture.Name}"/>
								<TextBlock Text=" | "/>
								<TextBlock Text="{Binding CurrentProduct.Name}"/>
							</WrapPanel>

							<StackPanel Grid.Row="1"
										Orientation="Vertical"
										HorizontalAlignment="Left"
										VerticalAlignment="Center"
										Margin="8,8,8,8">
								<TextBlock Text="{Binding CurrentProduct.Category.Name ,  StringFormat = Категория: {0} }" />
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="{Binding CurrentProduct.Count,  StringFormat = Колличество: {0} }"/>
									<TextBlock Text="{Binding CurrentProduct.CountText }" Padding="5,0"/>
								</StackPanel>
								<TextBlock Text="{Binding CurrentProduct.Structure,  StringFormat = Состав: {0} }"/>
							</StackPanel>
						</Grid>
					</Grid>
				
</Window>
