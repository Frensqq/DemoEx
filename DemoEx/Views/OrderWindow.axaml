<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="450"
        xmlns:vm="using:DemoEx.ViewModels"
        x:DataType="vm:MainWindowViewModel"
        x:Class="DemoEx.Views.OrderWindow"
        Width="700" Height="700"
        Title="Оформление заказа">

    <Window.Styles>
        <Style Selector="NumericUpDown.arrowsOnly /template/ TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Background="#FFFFFF">

        <Border Grid.Row="0" Background="#D2F6E7" Padding="10">
            <TextBlock Text="Оформление заказа" FontSize="20" FontWeight="700"/>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="10" Spacing="10">

                <Image Source="{Binding CurrentProduct.ImageBitmap}" Width="150" Height="150"/>

                <TextBlock Text="{Binding CurrentProduct.Name}" FontSize="20" FontWeight="700"/>
                <TextBlock Text="{Binding CurrentProduct.Manufacture.Name}"/>

                <!-- Цена и скидка -->
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding CurrentProduct.Price, StringFormat={}{0:C}}" FontSize="18" FontWeight="600"/>
                    <TextBlock Text="{Binding CurrentProduct.DiscountPrice, StringFormat={}{0:C}}"
                               FontSize="16"
                               Foreground="Red"
                               IsVisible="{Binding CurrentProduct.Discount}"/>
                </StackPanel>

                <TextBlock Text="{Binding CurrentProduct.Category.Name, StringFormat='Категория: {0}'}"/>
                <TextBlock Text="{Binding CurrentProduct.Structure, StringFormat='Состав: {0}'}"/>
                <TextBlock Text="{Binding CurrentProduct.Description, StringFormat='Описание: {0}'}"/>

                <TextBlock Text="Размер:" FontWeight="600"/>
                <ComboBox ItemsSource="{Binding CurrentProduct.Stoks}"
                          SelectedItem="{Binding CurrentStock, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Size.Name, StringFormat='Размер {0}'}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Количество:" FontWeight="600"/>
                <NumericUpDown Classes="arrowsOnly"
                               Value="{Binding CurrentCount, Mode=TwoWay}"
                               Minimum="0"
                               Maximum="{Binding CurrentStock.Count}"
                               Increment="1"
                               FormatString="0"/>

                <TextBlock Text="{Binding OrderError}" Foreground="#ff8080"/>

                <TextBlock Text="Доступные размеры:" FontWeight="600"/>
                <ItemsControl ItemsSource="{Binding CurrentProduct.Stoks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Size.Name, StringFormat='Размер: {0}'}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat='{}{0} шт.'}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#D2F6E7" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="Отмена" Click="OnCancelClick"/>
                <Button Content="Добавить в заказ"
                        Command="{Binding AddToOrderCommand}"
                        Background="#70B2AF"
                        Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>