<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="450"
        xmlns:vm="using:DemoEx.ViewModels"
        x:DataType="vm:MainWindowViewModel"
        x:Class="DemoEx.Views.OrderWindow"
        Width="700" Height="700"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Оформление заказа">

    <Window.Styles>
        <Style Selector="NumericUpDown.arrowsOnly /template/ TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Background="#F7F7F7">

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#3A3438" Padding="20,14">
            <TextBlock Text="Оформление заказа"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="700"/>
        </Border>

        <!-- Контент -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="24" ColumnSpacing="24">

            <Border Grid.Column="0"
        Background="White"
        BorderBrush="#E0E0E0"
        BorderThickness="1"
        Padding="12"
        VerticalAlignment="Top">
    <StackPanel Spacing="12">

        <Image Source="{Binding CurrentProduct.ImageBitmap}"
               Width="200" Height="200"
               Stretch="Uniform"/>

        <StackPanel Spacing="4">
            <TextBlock Text="Размер:" FontWeight="600"/>
        <ComboBox ItemsSource="{Binding CurrentProduct.Stoks}"
                  SelectedItem="{Binding CurrentStock, Mode=TwoWay}"
                  HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Size.Name, StringFormat=Размер {0}}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox> 
        </StackPanel>

        <TextBlock Text="{Binding OrderError}" Foreground="Red" TextWrapping="Wrap"/>

        <StackPanel Spacing="4">
            <TextBlock Text="Количество:" FontWeight="600"/>
                  <NumericUpDown Classes="arrowsOnly"
                       Value="{Binding CurrentCount, Mode=TwoWay}"
                       Minimum="0"
                       Maximum="{Binding CurrentStock.Count}"
                       Increment="1"
                       FormatString="0"
                       HorizontalAlignment="Stretch"/>  
        </StackPanel>

    </StackPanel>
</Border>

            <StackPanel Grid.Column="1" Spacing="10">

                <TextBlock Text="{Binding CurrentProduct.Name}"
                           FontSize="22" FontWeight="700"
                           TextWrapping="Wrap"/>

                <TextBlock Text="{Binding CurrentProduct.Manufacture.Name}"
                           FontSize="14" Foreground="#8A8578"/>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding CurrentProduct.Price, StringFormat={}{0:C}}"
                               FontSize="20" FontWeight="600"/>
                    <TextBlock Text="{Binding CurrentProduct.DiscountPrice, StringFormat={}{0:C}}"
                               FontSize="18" Foreground="#E85A3A"
                               IsVisible="{Binding CurrentProduct.Discount}"/>
                </StackPanel>

                <Rectangle Height="1" Fill="#E0E0E0" Margin="0,6"/>

                <TextBlock Text="{Binding CurrentProduct.Category.Name, StringFormat=Категория: {0}}"/>
                <TextBlock Text="{Binding CurrentProduct.Structure, StringFormat=Состав: {0}}"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding CurrentProduct.Description, StringFormat=Описание: {0}}"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Доступные размеры:"
                           FontWeight="600"
                           Margin="0,10,0,0"/>

                <ItemsControl ItemsSource="{Binding CurrentProduct.Stoks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    Padding="8,4"
                                    Margin="0,2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Size.Name, StringFormat=Размер: {0}}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Count, StringFormat=В наличии: {0} шт.}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </Grid>

        <!-- Кнопки -->
        <Border Grid.Row="2" Background="#EDE7DE" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                <Button Content="Отмена"
                        Click="OnCancelClick"
                        Padding="24,10"
                        CornerRadius="6"/>
                <Button Content="Добавить в заказ"
                        Command="{Binding AddToOrderCommand}"
                        Background="#E85A3A"
                        Foreground="White"
                        Padding="24,10"
                        CornerRadius="6"
                        FontWeight="600"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>