<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DemoEx.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="DemoEx.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/ChydoObuv.ico"
        Title="DemoEx">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid ColumnDefinitions="180,*,Auto" RowDefinitions="Auto,*,Auto">

        <!-- Сайдбар: текущий заказ -->
        <Grid Grid.Column="0" Grid.Row="1" Grid.RowSpan="2" Background="#D2F6E7">
            <Grid RowDefinitions="Auto,*,Auto">

                <ScrollViewer Grid.Row="1">
                    <StackPanel Spacing="5" Margin="5">
                        <TextBlock Text="Текущий заказ"
                                   IsVisible="{Binding IsAuth}"
                                   FontWeight="600"
                                   HorizontalAlignment="Center"/>

                        <ItemsControl ItemsSource="{Binding CurrentOrder.DetailOrders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFFFFF" Margin="0,0,0,5" Padding="5">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Product.Name}" FontWeight="600" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Size.Name, StringFormat='Размер: {0}'}"/>
                                            <TextBlock Text="{Binding Count, StringFormat='Кол-во: {0}'}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Низ: кнопки -->
                <StackPanel Grid.Row="2" Spacing="5" Margin="5">

                    <Button Content="Оформить заказ"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="#70B2AF"
                            Foreground="White"
                            Command="{Binding CreateOrderCommand}"
                            IsVisible="{Binding CurrentOrder, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                    <Button Content="{Binding ListOrderButtonName}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="#70B2AF"
                            Foreground="White"
                            IsVisible="{Binding ListOrderButtonVisible}"
                            Command="{Binding ListOrderToMainWindowCommand}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Шапка с логотипом -->
        <Grid Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Background="#D2F6E7">
            <StackPanel Orientation="Horizontal" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <Image Source="avares://DemoEx/Assets/ChydoObuv.ico" Height="40" Stretch="Uniform"/>
                <TextBlock FontSize="22" FontWeight="700" VerticalAlignment="Center" Text="Чудо обувь"/>
            </StackPanel>
        </Grid>

        <!-- Пользователь и вход -->
        <Grid Grid.Row="0" Grid.Column="2" Background="#D2F6E7">
            <StackPanel Orientation="Vertical" Margin="10">
                <TextBlock TextAlignment="Center"
                           FontWeight="600"
                           TextWrapping="Wrap"
                           Text="{Binding CurrentUserName}"/>

                <Button HorizontalAlignment="Center"
                        Content="Вход"
                        Background="#70B2AF"
                        Foreground="White"
                        Command="{Binding ToLogPageCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Контент -->
        <ContentControl Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Content="{Binding Page}"/>

        <!-- Подвал -->
        <Grid Grid.Column="1" Grid.Row="2" Background="#D2F6E7">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="А тут конец"/>
        </Grid>
    </Grid>
</Window>