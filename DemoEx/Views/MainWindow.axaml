<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DemoEx.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="DemoEx.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/ChydoObuv.ico"
        Title="DemoEx">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,*,Auto">

        <!-- Боковая панель -->
        <Grid Grid.Column="0" Grid.Row="1" Grid.RowSpan="2">
            <Grid RowDefinitions="Auto,*,Auto" Background="#2E2A2E">

                <!-- Верх: пользователь + вход -->
                <StackPanel Grid.Row="0">
                    <TextBlock TextAlignment="Center"
                               FontSize="18"
                               Foreground="White"
                               FontWeight="600"
                               Margin="0,24,0,12"
                               TextWrapping="Wrap"
                               Text="{Binding CurrentUserName}"/>

                    <Button HorizontalAlignment="Center"
                            Content="Вход"
                            Background="#E85A3A"
                            Foreground="White"
                            Padding="24,10"
                            CornerRadius="6"
                            FontWeight="600"
                            Command="{Binding ToLogPageCommand}"/>
                </StackPanel>

                <!-- Середина: список текущего заказа -->
                <ScrollViewer Grid.Row="1" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Текущий заказ"
                                   Foreground="White"
                                   FontWeight="600"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>

                        <ItemsControl ItemsSource="{Binding CurrentOrder.DetailOrders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#3A3438"
                                            Margin="6,3"
                                            Padding="6"
                                            CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Product.Name}"
                                                       Foreground="White"
                                                       FontWeight="600"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Size.Name, StringFormat='Размер: {0}'}"
                                                       Foreground="#CFC7C7"
                                                       FontSize="12"/>
                                            <TextBlock Text="{Binding Count, StringFormat='Кол-во: {0}'}"
                                                       Foreground="#CFC7C7"
                                                       FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Низ: кнопка оформления -->
                <Button Grid.Row="2"
                        Content="Оформить заказ"
                        HorizontalAlignment="Stretch"
                        Margin="8"
                        Padding="8"
                        Background="#E85A3A"
                        Foreground="White"
                        CornerRadius="6"
                        Command="{Binding CreateOrderCommand}"
                        IsVisible="{Binding CurrentOrder, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </Grid>
        </Grid>

        <!-- Шапка -->
        <Grid Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Background="#3A3438">
            <StackPanel Height="60" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Foreground="White" FontSize="22" FontWeight="700">
                    Чудо обувь — чудо а не обувь
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Контент -->
        <ContentControl Grid.Column="1" Grid.Row="1" Content="{Binding Page}"/>

        <!-- Подвал -->
        <Grid Grid.Column="1" Grid.Row="2" Background="#1F1C1F">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#B0A8A8" Text="frens-project.tech"/>
        </Grid>
    </Grid>
</Window>