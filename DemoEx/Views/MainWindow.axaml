<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DemoEx.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="DemoEx.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/ChydoObuv.ico"
        Title="DemoEx">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>


        <Grid ColumnDefinitions = "Auto,*" RowDefinitions = "Auto,*,Auto" >

            <Grid Grid.Column="0" Grid.Row="1" Grid.RowSpan="2">
                 <StackPanel Width="100" Background="Aqua"></StackPanel>
            </Grid>

            <Grid Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2">

                <StackPanel Height="100" Background="White"></StackPanel>
        
            </Grid>

            <ContentControl Grid.Column="1" Grid.Row="1" Content="{Binding Page}"/>


            <Grid Grid.Column="1" Grid.Row="2">
                <StackPanel Height="100" Background="White"></StackPanel>
            </Grid>
        </Grid>

    

</Window>
