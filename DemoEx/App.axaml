<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DemoEx.App"
             xmlns:local="using:DemoEx"
             xmlns:conv="clr-namespace:DemoEx.Resources"
             xmlns:convCol="clr-namespace:DemoEx.Resources"
             RequestedThemeVariant="Light">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />


        <Style Selector="Window, UserControl">
        <Setter Property="FontFamily" Value="Calibri"/>
    </Style>

    <!-- Акцентные кнопки (замена красного #E85A3A на #70B2AF) -->
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#70B2AF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="TextBlock.hasDiscount">
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontWeight" Value="700"/>
            <Setter Property="TextDecorations" Value="Strikethrough"/>
        </Style>
    </Application.Styles>

    <Application.Resources>
        <conv:ImageConverter x:Key="ImageConverter"/>
        <convCol:ColorConverter x:Key="ColorConverter"/>
    </Application.Resources>
</Application>